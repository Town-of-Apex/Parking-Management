# Parking Management — public repository ignore rules
# Models, operational data, secrets, and local tooling stay off the remote.

# --- Secrets and local configuration ---
.env
.env.*
!.env.example
*.env
*.pem
*.key
*.p12
*.pfx
*.crt
id_rsa
id_ed25519
credentials.json
secrets.json
service-account*.json
secrets/

# Local Compose overrides often hold host paths or real credentials.
compose.override.yaml
compose.override.yml
docker-compose.override.yaml
docker-compose.override.yml

# --- Model weights ---
# YOLO / RT-DETR / TensorRT artifacts. Download or mount these at runtime.
*.pt
*.pth
*.onnx
*.engine
*.trt
*.weights
*.ckpt
*.safetensors
*.torchscript
runs/
wandb/

# --- Operational data ---
# Occupancy logs, zone geometry, analytics extracts, and database files.
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
bounding_boxes.json
exports/
data/
backups/
*.dump
*.sql.gz
*.csv

# Captured frames and recordings. Real camera imagery does not belong in git.
*.jpg
*.jpeg
*.png
*.bmp
*.tif
*.tiff
*.webp
*.gif
*.mp4
*.avi
*.mov
*.mkv
*.webm
*.ts
# UI assets under the dashboard stay tracked.
!dashboard/static/**/*.jpg
!dashboard/static/**/*.jpeg
!dashboard/static/**/*.png
!dashboard/static/**/*.gif
!dashboard/static/**/*.webp
!dashboard/static/**/*.svg

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
wheels/
*.egg-info/
.eggs/
*.egg
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover

# --- Editors, OS, and local agent state ---
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
Desktop.ini
*.swp
*.swo
*~
.idea/
.vscode/
*.code-workspace
.cursor/
.agent/
